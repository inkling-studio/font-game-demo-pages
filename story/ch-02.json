          {
            "char": "草",
            "pinyin": "cǎo",
            "icon": "🌿"
          }
        ],
        "correctCharId": "花",
        "onCorrect": {
          "magicDialogue": "太聪明了！「花」字刚念出来，白水仙们一朵接一朵张开花瓣，醒了过来。它们齐齐朝着森林的方向点头，像一排小小的白路标。小熊拍拍手说：「哇，你们好呀，谢谢你们指路！」",
          "audio": "audio/ch02-scene-03-correct.mp3",
          "spriteAction": {
            "spriteId": "waking-flowers",
            "animation": "appear"
          },
          "characterAction": [
            {
              "spriteId": "character",
              "animation": "walk"
            },
            {
              "spriteId": "bear",
              "animation": "walk"
            }
          ],
          "completionDialogue": "白水仙们摇摇摆摆，像是在说「不客气」。小勇士和小熊沿着花朵指的方向踏上栈道，每一步都踩得稳稳的。青蛙们唱得更欢了，像是在送行。穿过沼泽，前面就是红土荒漠了。",
          "completionAudio": "audio/ch02-scene-03-complete.mp3",
          "nextScene": "scene-04",
          "slideOffscreenSpriteIds": [

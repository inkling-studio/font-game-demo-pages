# Vite 内容哈希文件名，可不可变缓存一年（支撑 PRD "秒级加载"）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 图片/音频走查询串版本号（?v=<hash>，由 asset-manifest.json 驱动，见 ADR-0023），
# 路径不变、内容变化时 URL 变化，可安全长缓存一年
/images/*
  Cache-Control: public, max-age=31536000, immutable
/audio/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 与其他资源（含 story/*.json、asset-manifest.json 本身）每次校验，保证新部署立即可见
/*
  Cache-Control: public, max-age=0, must-revalidate
